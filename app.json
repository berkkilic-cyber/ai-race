{
  "expo": {
    "name": "Benchmaxxing",
    "slug": "ai-race",
    "owner": "bullgrinder",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/f57a074c-822d-48e6-8a8f-003dacfe13f8"
    },
    "orientation": "landscape",
    "icon": "./assets/images/icon.png",
    "scheme": "airace",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.bullgrinder.airace",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.bullgrinder.airace",
      "adaptiveIcon": {
        "backgroundColor": "#0b1620",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0b1620",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "iosAppId": "ca-app-pub-2761229802602660~8787359842",
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "userTrackingUsageDescription": "This lets the ads you choose to watch be more relevant. The game works the same either way.",
          "skAdNetworkItems": [
            "cstr6suwn9.skadnetwork"
          ]
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "This lets the ads you choose to watch be more relevant. The game works the same either way."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#0b1620",
    "extra": {
      "eas": {
        "projectId": "f57a074c-822d-48e6-8a8f-003dacfe13f8"
      }
    }
  }
}
